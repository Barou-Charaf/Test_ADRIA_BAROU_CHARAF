enum AccountStatus {
    ACTIVE
    BLOCKED
}

type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

type AccountBalance {
    accountId: ID!
    balance: Float!
}

input CreateAccountInput {
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

type Query {
    accounts: [Account!]!
    account(id: ID!): Account!
    accountBalance(id: ID!): AccountBalance!
}

type Mutation {
    createAccount(input: CreateAccountInput!): Account!
    updateAccountStatus(id: ID!, status: AccountStatus!): Account!
    debitAccount(id: ID!, amount: Float!): Account!
    creditAccount(id: ID!, amount: Float!): Account!
}
